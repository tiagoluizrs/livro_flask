# Copie este arquivo para ".env" e preencha com os seus valores.
# O arquivo ".env" nunca deve ser commitado (ele já está no .gitignore).

FLASK_ENV=development
SECRET_KEY=troque-essa-chave-por-uma-bem-dificil-de-adivinhar

# Usadas pelo comando `flask` (flask run)
FLASK_APP=run.py
# Só necessário se quiser que o `flask run` use a mesma porta do config.py
FLASK_RUN_PORT=8000

# Banco de dados
MYSQL_USER=root
MYSQL_PASSWORD=123
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=livro_flask

# E-mail (Flask-Mail)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=sua-senha-de-app
MAIL_DEFAULT_SENDER=seu-email@gmail.com

# Mensageria e gRPC (capítulos 15, 16 e 18)
RABBITMQ_HOST=localhost
RABBITMQ_USER=estoque
RABBITMQ_PASSWORD=troque-essa-senha
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
GRPC_PORT=50051
